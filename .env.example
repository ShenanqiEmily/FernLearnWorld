# Copy this file to `.env` and fill in real values.
# NEVER commit the actual `.env` file — it's already in .gitignore.
#
# For Render specifically: you don't need a `.env` file on the server at all.
# Set these as Environment Variables in the Render dashboard instead (or via
# render.yaml, which handles SECRET_KEY/DATABASE_URL/ALLOWED_HOSTS
# automatically). This file exists so anyone cloning the repo — including
# your own local machine — knows exactly what to configure.

# --- Core ---
SECRET_KEY=                      # generate a new one for each environment
DEBUG=True                       # True locally, False in production
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Leave blank locally (falls back to SQLite automatically). On Render this
# is auto-populated if you deploy via render.yaml with an attached database.
DATABASE_URL=

# --- Media storage (S3, optional) ---
# Leave all blank to use local disk (fine for a portfolio demo — Render's
# disk is ephemeral though, so uploaded profile pictures reset on redeploy
# unless you fill these in).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1

# --- Email (password reset etc.) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM_ADDRESS=
DEFAULT_FROM_EMAIL=

# --- Third-party APIs ---
ANTHROPIC_API_KEY=               # required for the AI Tutor feature to work
AI_TUTOR_MODEL=claude-haiku-4-5
STRIPE_SECRET_KEY=               # only needed if payments are enabled
STRIPE_PUBLISHABLE_KEY=

# --- Misc ---
STUDENT_ID_PREFIX=ugr
LECTURER_ID_PREFIX=
